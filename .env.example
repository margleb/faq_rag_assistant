# Ключ с доступом к модели из LLM_MODEL. Обязателен для /chat и main.py,
# индексация и evaluation работают без него.
OPENAI_API_KEY=

# Значения по умолчанию рассчитаны на локальный запуск.
# В docker compose они переопределяются на имена сервисов.
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379
