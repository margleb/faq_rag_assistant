{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: FAQ RAG Assistant",
      "type": "debugpy",
      "request": "launch",
      "module": "faq_rag_assistant.main",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true,
      "stopOnEntry": false
    }
  ]
}